{
  "name": "@wirecat/tg-cli",
  "version": "0.44.0",
  "description": "A local command line interface for a personal Telegram account, built for agents and scripts",
  "license": "Apache-2.0",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/tg-cli.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "bin": {
    "tg": "dist/bin/tg.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "install",
    "spec/bot/LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:matrix": "vitest run >/dev/null && tsc --build --force >/dev/null && cli-dev test-matrix --program dist/program.js --untested scripts/test-matrix-untested.ts --name tg --check",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "docs:check": "node --experimental-strip-types scripts/docs-check.ts && cspell --no-progress --no-summary README.md 'docs/*.md' && rumdl check --config config/wirecat/rumdl.toml --disable MD028 README.md docs/*.md",
    "parity:check": "pnpm build && node dist/bin/tg.js commands --json | cli-messaging-parity tg && node dist/bin/tg.js commands --json | cli-messaging-parity tg --pages README.md docs/*.md",
    "smoke:live": "pnpm build && node --experimental-strip-types scripts/smoke-live.ts",
    "release:check": "pnpm build && node --experimental-strip-types scripts/release-check.ts",
    "version:check": "cli-dev version",
    "version:sync": "cli-dev version --sync",
    "generate": "pnpm bot:generate && pnpm build && node --experimental-strip-types scripts/commands.ts",
    "probe:random-id": "pnpm build && node --experimental-strip-types scripts/probe-random-id.ts",
    "probe:sessions": "pnpm build && node --experimental-strip-types scripts/live-two-processes.ts",
    "probe:sessions-parallel": "pnpm build && node --experimental-strip-types scripts/live-two-processes.ts --parallel",
    "spike:live": "bin/tg-spike-live",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "postinstall": "node install/postinstall.mjs",
    "bot:generate": "node --experimental-strip-types scripts/bot/generate.ts",
    "bot:generate:check": "node --experimental-strip-types scripts/bot/generate.ts --check",
    "check:agent-docs": "pnpm build && node --experimental-strip-types scripts/check-agent-docs.ts",
    "standards:check": "node config/wirecat/check.mjs",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md"
  },
  "dependencies": {
    "@mtcute/node": "0.32.3",
    "@wirecat/cli-core": "0.18.1",
    "@wirecat/cli-messaging": "0.216.0",
    "commander": "15.0.0",
    "undici": "7.30.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-ru_ru": "2.3.3",
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "cspell": "10.3.6",
    "lefthook": "2.1.16",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2",
    "unpdf": "1.8.1",
    "vitest": "^5.0.2",
    "@cspell/dict-es-es": "3.0.9",
    "markdownlint-cli2": "0.23.3"
  }
}
